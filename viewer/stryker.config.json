{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "mutate": [
    "plugin/core/**/*.ts"
  ],
  "reporters": [
    "clear-text"
  ],
  "thresholds": {
    "high": 100,
    "low": 100,
    "break": 100
  },
  "concurrency": 2,
  "tempDirName": ".stryker-tmp"
}
